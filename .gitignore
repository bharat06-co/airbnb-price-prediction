# Raw snapshots are intentionally versioned (each is under GitHub's 100 MB/file limit)
# so that the 2026 experiments remain reproducible if source URLs expire.
# Uncompressed extracts, temporary downloads, and local files are ignored.
data/raw/*.csv
data/raw/*.part
data/raw/*.tmp
!data/raw/.gitkeep

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# OS / editors
.DS_Store
.vscode/
.idea/
